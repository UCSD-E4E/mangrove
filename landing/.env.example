# Required — get a free token at mapbox.com (used for satellite basemap tiles)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Optional — real image URLs for the SplitCompare before/after viewer.
# When set, <img> elements are used instead of gradient placeholders.
VITE_SPLIT_LEFT_URL=
VITE_SPLIT_RIGHT_URL=
