# Required — get a free token at mapbox.com (used for satellite basemap tiles)
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Optional — real image URLs for the SplitCompare before/after viewer.
# When set, <img> elements are used instead of gradient placeholders.
VITE_SPLIT_LEFT_URL=
VITE_SPLIT_RIGHT_URL=

# Public URL of the Cloudflare R2 bucket serving tiles.
# Leave empty to use local tiles from landing/public/tiles/ during development.
# In production, set this in GitHub repo secrets as VITE_TILES_BASE_URL.
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
VITE_TILES_BASE_URL=
